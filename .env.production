# MahaArogya — Production Environment Configuration Template
# INSTRUCTIONS: Populate all fields before deploying. Never commit real keys to version control.

APP_ENV=production
PORT=8000
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET_KEY=REDACTED_SET_VIA_SECURE_VAULT_OR_ENV
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS Whitelist (Comma-separated HTTPS origins)
CORS_ALLOWED_ORIGINS=https://mahaarogya.gov.in,https://admin.mahaarogya.gov.in,https://opd.mahaarogya.gov.in

# Database & Storage
DATABASE_PATH=/var/lib/mahaarogya/mahaarogya.db
DATA_DIR=/var/lib/mahaarogya/data

# Hardware / Acceleration
DEVICE=cuda
COMPUTE_TYPE=float16
